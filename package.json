{
  "name": "ctut-ewars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:dev": "tsx watch src/workers/index.ts",
    "worker:start": "node dist/worker/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typeorm": "tsx ./node_modules/typeorm/cli.js -d src/db/cli-data-source.ts",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/db/cli-data-source.ts",
    "migration:check": "tsx ./node_modules/typeorm/cli.js migration:generate --check -d src/db/cli-data-source.ts src/db/migrations/Check",
    "migration:run": "tsx scripts/run-migrations.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/db/cli-data-source.ts",
    "db:init": "tsx scripts/db-init.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed.ts --demo",
    "prepare": "husky || true",
    "worker:build": "esbuild src/workers/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/worker/index.mjs",
    "templates:build": "tsx scripts/build-templates.ts",
    "demo:load": "tsx scripts/load-demo-data.ts",
    "perf:seed": "tsx scripts/perf-seed.ts",
    "perf:measure": "tsx scripts/perf-measure.ts",
    "backup": "tsx scripts/db-backup.ts backup",
    "restore": "tsx scripts/db-backup.ts restore",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "test:e2e": "playwright test",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.55.0",
    "minio": "^8.0.7",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.8.0",
    "reflect-metadata": "^0.2.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "typeorm": "^0.3.31",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "jszip": "^3.10.2",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
