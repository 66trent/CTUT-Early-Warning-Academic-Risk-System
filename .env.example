# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.
# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Tên hiển thị trên giao diện và email (dùng chung mọi nơi)
NEXT_PUBLIC_APP_NAME=CTUT-EWARS

# PostgreSQL — Docker Compose tạo DB theo 3 biến POSTGRES_*, phải khớp DATABASE_URL
POSTGRES_USER=ewars
POSTGRES_PASSWORD=
POSTGRES_DB=ewars
DATABASE_URL=postgresql://ewars:<POSTGRES_PASSWORD>@localhost:5432/ewars

REDIS_URL=redis://localhost:6379

# Better Auth — AUTH_SECRET ít nhất 32 ký tự ngẫu nhiên
AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Đuôi email cán bộ (Cố vấn học tập, Admin), có dấu @ ở đầu.
# Tạm dùng "*" khi chưa có email trường: nhận mọi email trừ email sinh viên. Triển khai thật: @ctuet.edu.vn
STAFF_EMAIL_DOMAIN=@ctuet.edu.vn

# Tài khoản Admin đầu tiên (npm run seed) — mật khẩu ≥ 8 ký tự
ADMIN_SEED_EMAIL=admin@ctuet.edu.vn
ADMIN_SEED_PASSWORD=

# Bật tính năng demo: đăng nhập nhanh, seed:demo, trang /design-check, chọn asOf khi chạy đánh giá.
# Tắt (false) khi triển khai thật.
DEMO_MODE=true
# Mật khẩu 2 tài khoản Cố vấn học tập demo (GV001, GV002) — bắt buộc khi DEMO_MODE=true, ≥ 8 ký tự
DEMO_ADVISOR_PASSWORD=

# Google OAuth cho sinh viên — để trống thì ẩn nút đăng nhập Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MinIO lưu file CSV gốc — 2 khóa cũng là tài khoản quản trị MinIO trong Docker Compose
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=ewars-imports

# Email (dev dùng MailHog: http://localhost:8025, không cần USER/PASSWORD)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ctuet.edu.vn

# Mức log vận hành: debug | info | warn | error
LOG_LEVEL=info
